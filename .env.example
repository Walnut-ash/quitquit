# 复制为 .env.local 后填写，仅供本机后端读取。不要使用 VITE_ 前缀，不要提交真实密钥。

# 火山方舟（豆包）示例：
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=doubao-seed-evolving
# 其他 OpenAI 兼容服务同理：填到 /v1 或 /api/v3 这一层，不要带 /chat/completions。

# 模型服务的 OpenAI 兼容地址
LLM_BASE_URL=
# 模型名或接入点 ID，需支持 JSON 输出（response_format: json_object）
LLM_MODEL=
# 密钥；官方示例里的 ARK_API_KEY 等价于这里的 LLM_API_KEY
LLM_API_KEY=
# 后端端口，须与 vite.config.ts 的代理一致
BACKEND_PORT=8787
